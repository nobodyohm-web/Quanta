# OS
.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust
src-tauri/target/

# Tauri build
src-tauri/gen/
*.dmg

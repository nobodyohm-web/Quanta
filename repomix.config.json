{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 5,
    "showLineNumbers": true
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "src-tauri/target/**",
      "node_modules/**",
      ".svelte-kit/**",
      "build/**",
      "*.pyc",
      "__pycache__/**"
    ]
  }
}

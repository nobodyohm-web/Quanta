{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Périmètre IPC de la fenêtre principale — A1/A7 (audit 2026-08-13). Chaque commande applicative est accordée EXPLICITEMENT : une commande ajoutée sans être listée ici est refusée, ce qui est le bon défaut.",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": []
  },
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "allow-ui-diag",
    "allow-ui-beat",
    "allow-was-guardian-reload",
    "allow-check-identity",
    "allow-create-identity",
    "allow-unlock-identity",
    "allow-lock-wallet",
    "allow-is-wallet-unlocked",
    "allow-get-public-key",
    "allow-get-recovery-key",
    "allow-get-recovery-phrase",
    "allow-restore-from-phrase",
    "allow-get-receive-address",
    "allow-validate-address",
    "allow-biometric-status",
    "allow-enable-biometric-unlock",
    "allow-disable-biometric-unlock",
    "allow-unlock-biometric",
    "allow-get-node-status",
    "allow-get-node-mode",
    "allow-get-peer-metrics",
    "allow-set-display-name",
    "allow-get-display-name",
    "allow-get-security-audit",
    "allow-connect-peer",
    "allow-get-my-reputation",
    "allow-ledger-transfer",
    "allow-ledger-stake",
    "allow-ledger-unstake",
    "allow-get-wallet-overview",
    "allow-get-chain-overview",
    "allow-get-chain-history",
    "allow-get-recent-txs",
    "allow-get-finality-status",
    "allow-get-economy-stats",
    "allow-claim-username",
    "allow-resolve-username",
    "allow-is-username-available",
    "allow-get-my-username",
    "allow-get-my-connection-code",
    "allow-verify-connection"
  ]
}
